{
  "name": "tandem",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Edit your Kinesis Advantage 360 Pro layout, build its firmware in GitHub Actions, and flash both halves from the browser.",
  "license": "MIT",
  "author": "itsthecsguy",
  "repository": {
    "type": "git",
    "url": "https://github.com/itsthecsguy/tandem.git"
  },
  "scripts": {
    "dev": "vite",
    "dev:helper": "concurrently -k -n helper,web -c blue,magenta \"npm --prefix helper run dev\" \"TANDEM_HELPER=1 vite\"",
    "site": "vite build && wrangler dev --ip 127.0.0.1 --port 8787",
    "build": "vite build",
    "helper": "vite build && npm --prefix helper start",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p ."
  },
  "dependencies": {
    "@zmkfirmware/zmk-studio-ts-client": "^0.0.18",
    "fflate": "^0.8.2",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "run-script-os": "^1.1.6"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.152.0"
  }
}
